# =============================================================================
# Forge Local - variables de entorno
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores. NUNCA subas `.env` al repo.
#
#   cp .env.example .env
#
# En desarrollo, si SESSION_SECRET no está definido se genera uno efímero y las
# sesiones se invalidan al reiniciar. En producción es OBLIGATORIO.
# =============================================================================

# --- Servidor ---------------------------------------------------------------
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Datos persistentes: SQLite, backups temporales y temporales de comandos.
DATA_DIR=./data

# Raíz permitida para proyectos. Por defecto: ~/ForgeProjects
# PROJECTS_ROOT=./projects

# Directorio del frontend compilado. Normalmente se detecta solo.
# WEB_DIST=./apps/web/dist

# Origen público exacto (sin barra final). Obligatorio recomendarlo en producción.
# PUBLIC_ORIGIN=https://forge.example.com

# Actívalo SOLO si hay un proxy inverso de confianza delante (Coolify/Traefik).
TRUST_PROXY=false

# auto = Secure cuando la petición es HTTPS o PUBLIC_ORIGIN es https.
COOKIE_SECURE=auto

# Genera uno con: openssl rand -base64 48
# En producción el arranque falla si falta o es demasiado corto.
# SESSION_SECRET=

SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=48

# Registro público desactivado por defecto. Crea usuarios con la CLI.
ALLOW_REGISTRATION=false

# local = pensado para tu equipo; server = despliegue compartido.
DEPLOYMENT_MODE=local

# --- Runtime local (Ollama) -------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_AUTH_TOKEN=

# Permite cambiar la URL del runtime desde Ajustes. Si es false, solo se usa
# OLLAMA_BASE_URL. Con true, los hosts/puertos siguen limitados por las listas.
ALLOW_CUSTOM_RUNTIME=true

# Listas separadas por comas. Se añaden a las del runtime por defecto.
# RUNTIME_ALLOWED_HOSTS=ollama,192.168.1.50
# RUNTIME_ALLOWED_PORTS=11434

RUNTIME_TIMEOUT_MS=120000
RUNTIME_STREAM_IDLE_TIMEOUT_MS=120000

# --- Límites de contexto ----------------------------------------------------
# Valores pensados para un cliente ligero (4 GB de RAM): 128 KiB por archivo y
# 256 KiB por consulta. Súbelos solo si tu equipo tiene más memoria.
# El límite total debe ser >= el límite por archivo.
MAX_REQUEST_BYTES=1048576
MAX_MESSAGE_CHARS=20000
MAX_FILE_BYTES=131072
MAX_CONTEXT_BYTES=262144
MAX_CONTEXT_FILES=8

# Límite de datos persistidos por usuario (conversaciones + copias temporales),
# en bytes. Por defecto 64 MiB. Cada usuario puede bajarlo desde Ajustes.
MAX_STORAGE_BYTES=67108864

# --- Autenticación y abuso --------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_BASE_DELAY_MS=250
API_RATE_LIMIT_PER_MINUTE=120
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- Comandos (desactivados por defecto) ------------------------------------
# Si se habilita, se ejecutan sin shell, con timeout, salida limitada y solo
# binarios de la allowlist. No hay aislamiento de contenedor desde la app.
ENABLE_COMMAND_EXECUTION=false
COMMAND_ALLOWLIST=git,node,npm,npx
COMMAND_TIMEOUT_MS=30000
COMMAND_MAX_OUTPUT_BYTES=65536

# --- Propuestas y backups ---------------------------------------------------
BACKUP_RETENTION_DAYS=7
PROPOSAL_TTL_MINUTES=120

# =============================================================================
# Ejemplo de bloque para producción (Coolify / Docker Compose)
# =============================================================================
# NODE_ENV=production
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://forge.example.com
# TRUST_PROXY=true
# SESSION_SECRET=<openssl rand -base64 48>
# ALLOW_REGISTRATION=false
# DEPLOYMENT_MODE=server
# OLLAMA_BASE_URL=http://ollama:11434
# ALLOW_CUSTOM_RUNTIME=false
# ENABLE_COMMAND_EXECUTION=false
# MAX_STORAGE_BYTES=67108864
#
# Hardware:
# - El cliente solo ejecuta la interfaz. Con 4 GB de RAM, deja la inferencia en
#   el servidor remoto (DEPLOYMENT_MODE=server).
# - El servidor necesita RAM/VRAM suficiente para el modelo. No se asume GPU:
#   comprueba `ollama ps`, `free -h` y la ficha actual del modelo.
# - La app nunca descarga modelos. Hazlo manualmente con `ollama pull <modelo>`
#   después de verificar tamaño y requisitos.
